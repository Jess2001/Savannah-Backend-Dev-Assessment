                  "pm.test(\"Has UTC and clinic-local start\", () => { const b = pm.response.json(); pm.expect(b.start_time.endsWith(\"Z\")).to.be.true; pm.expect(b.local_start_time).to.include(\"+03:00\"); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"appointment_id\", b.id);",
                  "pm.collectionVariables.set(\"patient_id\", b.patient_id);"
