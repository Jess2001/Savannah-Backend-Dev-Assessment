    {
      "name": "2. Availability",
      "item": [
        {
          "name": "Get availability (saves two slots for later)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A weekday 7+ days ahead: inside the 1-hour notice and 60-day window.",
                  "const d = new Date();",
                  "d.setUTCDate(d.getUTCDate() + 7);",
                  "while ([0, 6].includes(d.getUTCDay())) { d.setUTCDate(d.getUTCDate() + 1); }",
                  "pm.collectionVariables.set(\"date\", d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Slots are 30 minutes long\", () => { const s = pm.response.json().slots[0]; pm.expect(new Date(s.end_time) - new Date(s.start_time)).to.eql(1800000); });",
                  "const slots = pm.response.json().slots;",
                  "pm.test(\"Doctor has slots that day\", () => pm.expect(slots.length).to.be.above(1));",
                  "if (slots.length > 1) {",
                  "  pm.collectionVariables.set(\"slot_start\", slots[0].start_time);",
                  "  pm.collectionVariables.set(\"slot_start_2\", slots[1].start_time);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/doctors/{{doctor_id}}/availability?date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "doctors",
                "{{doctor_id}}",
                "availability"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                }
              ]
            }
          }
        },
